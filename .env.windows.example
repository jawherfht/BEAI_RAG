# BEAI RAG — local mode (docker-compose.windows.yml). Copy this file to .env and set your key.
# .env is in .gitignore: your key never leaves your machine. Never commit it.

# --- LLM: Google AI Studio (Gemini, free tier), OpenAI-compatible endpoint -----------------
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=PASTE_YOUR_GOOGLE_AI_STUDIO_KEY_HERE
# Gemini 3 cannot switch thinking off: keep it low (fast, cheap). "none" only works on 2.5 models.
LLM_THINKING_SWITCH=reasoning_effort
LLM_REASONING_EFFORT=low

# --- Alternative: Groq (free tier) — comment the 5 Gemini lines above, uncomment these ------
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_API_KEY=PASTE_YOUR_GROQ_KEY_HERE
# LLM_THINKING_SWITCH=reasoning_effort
# LLM_REASONING_EFFORT=none

# --- Optional -------------------------------------------------------------------------------
LLM_TIMEOUT_S=30
# Re-ranker (Qwen3-Reranker-0.6B on CPU: several seconds per question). Off by default:
# RERANK_PROVIDER=local
