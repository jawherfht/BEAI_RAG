# Server-side only (never exposed to the browser).
RAG_API_URL=http://localhost:8000
# Dev auth: the Next.js proxy signs a short-lived gateway-style JWT for this tenant.
# In production the API Gateway authenticates the user and these are unset.
DEV_AUTH=true
DEV_TENANT_ID=00000000-0000-4000-8000-000000000001
DEV_JWT_SECRET=dev-only-change-me-to-a-32-plus-byte-secret
