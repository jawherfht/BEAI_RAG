# Copy to .env. Values below are for the local docker-compose stack.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me
QDRANT_COLLECTION=kb_chunks
DATABASE_URL=postgresql+asyncpg://beai:beai@localhost:5432/beai_rag
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=beai-kb
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
EMBED_PROVIDER=tei                    # tei | vllm | local
EMBED_URL=http://localhost:8080
EMBED_MODEL=microsoft/harrier-oss-v1-0.6b
EMBED_MODEL_REVISION=f9b9dc8d367d443f2479d27aa5d8d2850c0774ee  # verified, ADR 0001
# EMBED_QUERY_TEMPLATE=...             # query instruction from the model card; {text} = question
# TOKENIZER_MODEL=                     # defaults to EMBED_MODEL
EMBED_DIM=1024
SPARSE_MODEL=Qdrant/bm25
RERANK_PROVIDER=local                 # local (embed-server /rerank) | vllm | none
RERANK_URL=http://localhost:8080
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
LLM_BASE_URL=http://localhost:8000/v1  # prod: vLLM on the GPU pool
LLM_MODEL=Qwen/Qwen3.8-27B            # verified repo id, ADR 0001
# LLM_API_KEY=                        # unset when a proxy/gateway injects Authorization
LLM_THINKING_SWITCH=chat_template_kwargs  # vLLM; Groq: reasoning_effort
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=4
LLM_DISABLE_THINKING=true
# Dev without a GPU: the same model on Groq (OpenAI-compatible). The key is injected by the
# network proxy / secret store; never put it in this file.
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=qwen/qwen3.8-27b
#   LLM_THINKING_SWITCH=reasoning_effort
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.2
# Grounding signal and thresholds come from config/thresholds.<embed model>.json
# (eval/calibrate.py). Setting them here overrides the calibrated values:
# GROUNDING_SIGNAL=dense                # dense | rerank (re-ranker scores the final top_k)
# SCORE_THRESHOLD=0.45
# CONF_MID=0.55
# CONF_HIGH=0.70
# RERANK_SCORE_THRESHOLD=0.30           # re-ranker P(yes) scale
# RERANK_CONF_MID=0.50
# RERANK_CONF_HIGH=0.80
CONTEXTUAL_CHUNKS=false

# Ingestion worker
WORKER_CONCURRENCY=2
RETRY_BASE_MS=2000                    # retries after 2 s, 8 s, 32 s, then dead-letter
DOCLING_OCR=true
# DOCLING_ARTIFACTS_PATH=/models/docling  # pre-fetched Docling models (offline)
ANSWER_CACHE_TTL_S=86400
MAX_UPLOAD_MB=50
LANGFUSE_HOST=http://localhost:3000

# Auth (from the API Gateway). Dev uses HS256; prod uses the gateway's public key (RS256).
ENVIRONMENT=dev
JWT_ALGORITHMS=HS256
JWT_SECRET=dev-only-change-me-to-a-32-plus-byte-secret
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...
# API_KEYS={"<sha256 hex of key>": {"tenant_id": "<uuid>", "agents": ["<uuid>"]}}

# gRPC for the Interaction Agents Service (tenant/agent metadata trusted only over mTLS)
GRPC_ENABLED=true
GRPC_PORT=50051
# GRPC_TLS_CERT=/etc/beai/tls/server.crt
# GRPC_TLS_KEY=/etc/beai/tls/server.key
# GRPC_CLIENT_CA=/etc/beai/tls/clients-ca.crt
GRPC_ALLOW_INSECURE=false             # true only for local development
ANSWER_LOG_SAMPLE_RATE=0.1
