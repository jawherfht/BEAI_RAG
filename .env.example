# Copy to .env. Values below are for the local docker-compose stack.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me
QDRANT_COLLECTION=kb_chunks
DATABASE_URL=postgresql+asyncpg://beai:beai@localhost:5432/beai_rag
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=beai-kb
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
EMBED_PROVIDER=tei                    # tei | vllm | local
EMBED_URL=http://localhost:8080
EMBED_MODEL=microsoft/harrier-oss-v1-0.6b
EMBED_DIM=1024
SPARSE_MODEL=Qdrant/bm25
RERANK_URL=http://localhost:8081
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen3.8-27B                 # verify exact repo id (Phase 4)
LLM_API_KEY=not-needed-locally
LLM_DISABLE_THINKING=true
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.2
SCORE_THRESHOLD=0.45                  # placeholder -> calibrate (spec section 12)
CONF_HIGH=0.70                        # placeholder -> calibrate
CONF_MID=0.55                         # placeholder -> calibrate
CONTEXTUAL_CHUNKS=false
ANSWER_CACHE_TTL_S=86400
MAX_UPLOAD_MB=50
LANGFUSE_HOST=http://localhost:3000

# Auth (from the API Gateway). Dev uses HS256; prod uses the gateway's public key (RS256).
ENVIRONMENT=dev
JWT_ALGORITHMS=HS256
JWT_SECRET=dev-only-change-me
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...
# API_KEYS={"<sha256 hex of key>": {"tenant_id": "<uuid>", "agents": ["<uuid>"]}}
